[{"claim": "\u0635\u0648\u0631\u0629 \u0644\u0644\u0627\u0639\u0628 \u0643\u0631\u064a\u0633\u062a\u064a\u0627\u0646\u0648 \u0631\u0648\u0646\u0627\u0644\u062f\u0648 \u0648\u0647\u0648 \u064a\u062d\u0645\u0644 \u0643\u062a\u0627\u0628 \u0623\u0631\u062f\u0648\u063a\u0627\u0646 \u0627\u0644\u062c\u062f\u064a\u062f ", "id": 244, "source": "Fatabyyano", "root_tweet": {"id": 1440856738069053445, "text": "\u0627\u0644\u0643\u0631\u0627\u063a\u0644\u0629 \u062a\u0639\u0644\u0645\u0648 \u0627\u0644\u062a\u0632\u0648\u064a\u0631 \u0645\u0646 \u0627\u0644\u0627\u062a\u0631\u0627\u0643 \u0644\u064a \u0627\u0633\u062a\u0639\u0645\u0631\u0648\u0647\u0645 \u0627\u0631\u0628\u0639\u0629 \u0642\u0631\u0648\u0646 .. \u0642\u0627\u0644\u0643 \u0631\u0648\u0646\u0627\u0644\u062f\u0648 \u0643\u064a\u0642\u0631\u0627 \u0643\u062a\u0627\u0628 \u0627\u0631\u062f\u0648\u063a\u0627\u0646 \ud83d\ude02 https://t.co/7Vn05eGg0z", "stance": "Discussing", "leaning": "Refuting", "children": []}},
